
# Copy to backend/.env. Never commit backend/.env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
DEMO_MODE=true

# --- Firebase ---
FIREBASE_PROJECT_ID=your_firebase_project_id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# --- LLM ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Cost estimation (USD per 1M tokens) ---
LLM_INPUT_PRICE_PER_1M=0.10
LLM_OUTPUT_PRICE_PER_1M=0.40

# --- n8n ---
N8N_BASE_URL=http://localhost:5678
N8N_TIMEOUT_SECONDS=15
N8N_SHARED_SECRET=your_n8n_shared_secret
BACKEND_CALLBACK_SECRET=your_backend_callback_secret

# --- Public inquiry webhook ---
INQUIRY_WEBHOOK_SECRET=your_inquiry_webhook_secret

# --- Booking rules ---
BOOKING_SLOT_MINUTES=30
BOOKING_DAY_START_HOUR=9
BOOKING_DAY_END_HOUR=17
BOOKING_TIMEZONE=Asia/Dhaka
