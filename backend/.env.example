# Copy to backend/.env. Never commit .env.

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed origins (use real origins in production)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
# true = no Firebase/LLM/n8n required; responses are clearly labeled DEMO
DEMO_MODE=true

# ---------- Firebase (server-side) ----------
FIREBASE_PROJECT_ID=
# Local (non-Docker) runs: absolute path to your service account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# ---------- LLM ----------
# gemini | openai
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---------- Cost ESTIMATION (your own configured rates, USD per 1M tokens) ----------
# Estimates only. Verify against your provider's current pricing page.
LLM_INPUT_PRICE_PER_1M=0.10
LLM_OUTPUT_PRICE_PER_1M=0.40

# ---------- n8n ----------
N8N_BASE_URL=http://localhost:5678
N8N_TIMEOUT_SECONDS=15
# Backend -> n8n (must match root .env N8N_SHARED_SECRET)
N8N_SHARED_SECRET=
# n8n -> Backend callbacks (must match root .env BACKEND_CALLBACK_SECRET)
BACKEND_CALLBACK_SECRET=

# ---------- Public inquiry webhook ----------
# HMAC-SHA256 secret used to verify signed inquiry submissions
INQUIRY_WEBHOOK_SECRET=

# ---------- Booking rules ----------
BOOKING_SLOT_MINUTES=30
BOOKING_DAY_START_HOUR=9
BOOKING_DAY_END_HOUR=17
BOOKING_TIMEZONE=Asia/Dhaka