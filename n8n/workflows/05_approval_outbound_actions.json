                ]
            ]
        },
        "Validate and dedupe": {
            "main": [
                [
                    {
                        "node": "Prepare outbound email",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Prepare outbound email": {
            "main": [
                [
                    {
                        "node": "Safe to send?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Safe to send?": {
            "main": [
                [
                    {
                        "node": "Send email (SMTP)",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Callback: blocked",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Send email (SMTP)": {
            "main": [
                [
                    {
                        "node": "Callback: success",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Callback: send failed",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}