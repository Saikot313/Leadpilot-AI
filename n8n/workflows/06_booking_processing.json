                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ status: 'success', message: 'Confirmation email handed to the SMTP server.' + ($('Prepare booking emails').first().json.reminderAt ? ' A reminder is scheduled.' : ' No reminder: the meeting is within 24 hours.') }) }}",
                "options": {
                    "timeout": 15000
                }
            },
