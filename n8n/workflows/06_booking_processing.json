            "id": "n06-401",
            "name": "Respond 401",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                480,
                400
            ]
        },
        {
            "parameters": {
                "jsCode": "const j = $input.first().json; const b = j.body || {}; const ID = /^[A-Za-z0-9_-]{1,128}$/; const d = (b.data && typeof b.data === 'object') ? b.data : {}; const key = String(b.idempotencyKey || ''); if (!ID.test(String(b.workspaceId || '')) || !ID.test(String(b.executionId || ''))) return []; for (const f of ['leadId', 'approvalId', 'bookingId']) { if (d[f] !== undefined && d[f] !== null && !ID.test(String(d[f]))) return []; } if (!d.bookingId) return []; const sd = $getWorkflowStaticData('global'); sd.seen = sd.seen || {}; if (key && sd.seen[key]) return []; if (key) { sd.seen[key] = Date.now(); const ks = Object.keys(sd.seen); if (ks.length > 500) { ks.sort((x, y) => sd.seen[x] - sd.seen[y]).slice(0, ks.length - 500).forEach(k => delete sd.seen[k]); } } return [{ json: { workspaceId: b.workspaceId, executionId: b.executionId, mode: b.mode || 'live', data: d } }];"
            },
            "id": "n06-validate",
            "name": "Validate and dedupe",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                720,
                180
            ]
        },
        {
            "parameters": {
                "jsCode": "const c = $input.first().json; const d = c.data || {}; const EMAIL = /^[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+([.][A-Za-z0-9-]+)*[.][A-Za-z]{2,}$/; const from = String($env.OUTBOUND_FROM_EMAIL || '').trim(); const to = String(d.customerEmail || '').trim(); const name = String(d.customerName || 'there').replace(/[\\r\\n]+/g, ' ').trim().slice(0, 120) || 'there'; let when = String(d.startAt || ''); try { when = new Date(d.startAt).toLocaleString('en-GB', { timeZone: d.timezone || 'UTC', dateStyle: 'full', timeStyle: 'short' }) + ' (' + (d.timezone || 'UTC') + ')'; } catch (e) {} const rem = Date.parse(d.startAt) - 24 * 3600 * 1000; const reminderAt = (rem > Date.now() + 60000) ? new Date(rem).toISOString() : ''; let canSend = true; let notSentStatus = 'success'; let reason = ''; if (!EMAIL.test(to)) { canSend = false; reason = 'No valid customer email on the booking. Nothing was sent.'; } else if (!from) { canSend = false; notSentStatus = 'failed'; reason = 'OUTBOUND_FROM_EMAIL is not set in n8n. Nothing was sent.'; } return [{ json: { workspaceId: c.workspaceId, executionId: c.executionId, bookingId: d.bookingId, canSend, notSentStatus, reason, from, to, subject: 'Your meeting is confirmed', text: 'Hi ' + name + ',\\n\\nYour meeting is confirmed for ' + when + '.\\n\\nIf you need to change it, just reply to this email.\\n\\nBest regards', reminderSubject: 'Reminder: your meeting is tomorrow', reminderText: 'Hi ' + name + ',\\n\\nThis is a reminder of your meeting on ' + when + '.\\n\\nBest regards', reminderAt } }];"
            },
