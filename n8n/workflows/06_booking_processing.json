            ],
            "notes": "Select your SMTP credential on this node after importing.",
            "retryOnFail": true,
            "maxTries": 3,
            "waitBetweenTries": 3000,
            "onError": "continueErrorOutput"
        },
        {
            "parameters": {
                "method": "POST",
                "url": "={{ $env.BACKEND_URL + '/api/v1/internal/workspaces/' + $('Prepare booking emails').first().json.workspaceId + '/executions/' + $('Prepare booking emails').first().json.executionId + '/callback' }}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
