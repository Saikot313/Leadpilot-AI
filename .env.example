N8N_ENCRYPTION_KEY=replace_with_a_long_random_secret
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Dhaka

# --- Shared secrets ---
N8N_SHARED_SECRET=your_n8n_shared_secret
BACKEND_CALLBACK_SECRET=your_backend_callback_secret

# --- How n8n reaches the backend ---
N8N_BACKEND_URL=http://backend:8080

# --- AI configuration ---
GEMINI_API_KEY=your_gemini_api_key

# --- Workflow settings ---
LEADPILOT_WORKSPACE_ID=your_workspace_id
OUTBOUND_FROM_EMAIL=your_email@example.com
SUMMARY_TO_EMAIL=

# --- Port mapping ---
BACKEND_PORT=8080
