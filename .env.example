# Copy to .env (same folder as docker-compose.yml). Never commit .env.

# --- n8n ---
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Dhaka

# --- Shared secrets (must match backend/.env) ---
# Backend -> n8n: sent as X-LeadPilot-Secret header when triggering workflows
N8N_SHARED_SECRET=change-me-backend-to-n8n
# n8n -> Backend: sent as X-LeadPilot-Callback-Secret header on callbacks
BACKEND_CALLBACK_SECRET=change-me-n8n-to-backend

# --- How n8n reaches the backend ---
# Backend running in this compose file: leave the default.
# Backend running on your host with uvicorn: http://host.docker.internal:8080
N8N_BACKEND_URL=http://backend:8080

# --- n8n workflow settings (optional, see n8n/README.md) ---
# Workspace used by the scheduled daily summary and the error workflow
LEADPILOT_WORKSPACE_ID=demo-workspace
# Sender address for outbound emails. Leave empty to block all sending.
OUTBOUND_FROM_EMAIL=
# Recipient of the daily summary email. Leave empty to skip the email.
SUMMARY_TO_EMAIL=

# --- Port mapping ---
BACKEND_PORT=8080